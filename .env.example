# ============================================================================
# RT-HERMES Environment Configuration
# ============================================================================

# === Docker Configuration ===
# External port of the webservice container and restart policy of all containers
DOCKER_WEB_PORT=8000
DOCKER_RESTART_POLICY=unless-stopped

# === Main PostgreSQL Database ===
# Main database credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=mytopsecretpass  # CHANGE THIS in production!
POSTGRES_DB=postgres
POSTGRES_PORT=5434

# --- CLI ---
# Where to find the database when running hermes cli commands.
POSTGRES_HOST=localhost

# --- WORKERS ---
# Where to find the database for distributed workers.
# Replace with your server address or IP, localhost if running on the same machine.
# only used if CREDENTIAL_SOURCE=prefect
POSTGRES_HOST_EXTERNAL=http://my-server-address.ch

# Connection pool settings (used by webservice container and host CLI)
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10

# === Credential Source ===
# Where to load database credentials from:
# - 'env': Use POSTGRES_* variables above (default, for local/host machine)
# - 'prefect': For distributed workers.
# On the host, run 'hermes config set-credentials' to update credentials to Prefect.
# On workers, set CREDENTIAL_SOURCE=prefect to load from the block.
CREDENTIAL_SOURCE=env

# === Prefect Database ===
# Prefect uses a separate PostgreSQL database for workflow metadata
PREFECT_PASSWORD=password  # CHANGE THIS in production!
PREFECT_PORT=5433

# --- CLI ---
# Prefect API and Database connection.
# Replace 'password' in the connection URL with PREFECT_PASSWORD from above.
# Replace 'localhost' with your server address if not running locally.
# Replace '5433' with PREFECT_PORT from above.
PREFECT_API_DATABASE_CONNECTION_URL="postgresql+asyncpg://postgres:password@localhost:5433/prefect"
PREFECT_API_URL="http://127.0.0.1:4200/api"